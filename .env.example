# Salin ke Railway > service > Variables (bukan ke file, Railway tidak membaca .env)

# Wajib disarankan: kode undangan agar hanya tim yang bisa mendaftar
REGISTRATION_CODE=menujupusat2026

# Rahasia login (isi string acak panjang). Bila kosong, dibuat otomatis & disimpan di Volume.
JWT_SECRET=ganti-dengan-string-acak-panjang

# Opsional — Railway sudah mengisi otomatis dari domain service (RAILWAY_PUBLIC_DOMAIN).
# Isi hanya jika memakai domain sendiri, mis.:
# PUBLIC_URL=https://link.domainmu.id

# JANGAN isi PORT, RAILWAY_VOLUME_MOUNT_PATH, atau RAILWAY_PUBLIC_DOMAIN — diisi otomatis oleh Railway.
